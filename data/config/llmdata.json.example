{
  # Copy this file to: <your mod folder>/data/config/llmdata.json

  # Which model answers: "koboldcpp" (your own KoboldCpp server, e.g. Qwen on another PC), "rasa" (a Rasa NLU
  # server on this PC, no language model, see nlp/rasa/README.md), "spacy" (a spaCy NLU server on this PC, trained on
  # the same examples, see nlp/spacy/README.md) or "gemini" (Google's API).
  "provider": "koboldcpp",

  # ---- KoboldCpp (used when provider is "koboldcpp") ----
  # The model and its context size are picked when KoboldCpp is started, not here. Setup: nlp/koboldcpp/README.md.
  # The prompt is built in ChatML, the format Qwen models use.
  "koboldcpp": {
    # The other PC's Tailscale name (or its 100.x.y.z address) and KoboldCpp's port.
    "url": "http://YOUR-PC-NAME:5001",
    # Only if KoboldCpp was started with --password.
    "password": "",
    # false = answer straight away. true = reason first: sometimes smarter, but several times slower.
    "think": false,
    "maxOutputTokens": 512,
    # Lower = more consistent commands.
    "temperature": 0.2,
    "timeoutSeconds": 120
  },

  # ---- Rasa (used when provider is "rasa") ----
  # Reads the text with intent classification and entity extraction instead of an LLM. Every field is optional.
  "rasa": {
    # Where nlp/rasa/start-server.bat listens.
    "url": "http://127.0.0.1:5005",
    # Only if the server was started with --auth-token.
    "token": "",
    # Messages Rasa is less sure about than this count as not a request.
    "minConfidence": 0.5,
    "timeoutSeconds": 30
  },

  # ---- spaCy (used when provider is "spacy") ----
  # Same idea as Rasa, with spaCy and pretrained word vectors. Every field is optional.
  "spacy": {
    # Where nlp/spacy/start-server.bat listens.
    "url": "http://127.0.0.1:5007",
    # Messages spaCy is less sure about than this count as not a request.
    "minConfidence": 0.5,
    "timeoutSeconds": 30
    # Optional: which of the mod's fixes for spaCy's mistakes run, e.g. "rules": ["cancel", "faction"], or "all"
    # or "none". Without it the default set runs; nlp/spacy/README.md explains each one.
  },

  # ---- Gemini (used when provider is "gemini") ----
  # Get a key at https://aistudio.google.com/apikey
  # Never share the mod zip with a real key inside it.
  # Keys starting with PASTE_ count as "no key", so the mod reports the missing key instead of calling Google.
  "apiKey": "PASTE_YOUR_KEY_HERE",

  # Check Google's docs for the current model names, they change over time.
  "model": "gemini-3.1-flash-lite",

  # Gemini only. Thinking models spend part of this budget on reasoning, so don't set it too low.
  "maxOutputTokens": 1024,

  # Optional, Gemini only: "temperature" (lower = more consistent commands; the model's default when left out)
  # and "timeoutSeconds" (default 60). The Gemini settings may also sit in a "gemini": { ... } object, like the
  # other providers'; a value there wins over the one here.

  # ---- Gemini and KoboldCpp ----
  # The system prompt is in data/config/systemPrompt.txt, next to this file. A "systemPrompt": "..." here
  # wins over it, for trying out a variant without touching the file.

  # ---- The panel on the campaign screen ----
  # The key that opens and closes it (an LWJGL key name: F8, F9, INSERT, GRAVE, ...). Optional, default F8.
  "panelKey": "F8",

  # Where it starts: its top left corner, in pixels from the screen's top left, as "x, y" or [x, y]. Optional,
  # default the left edge under the top bar. Once it is dragged by the grip next to its button, it stays where it
  # was dragged to until the game is closed.
  "panelPosition": "20, 120",

  # Its size with the editor open, width and height in pixels, as "width, height" or [width, height]. Optional,
  # default 720, 435; at least 700, 300. Dragging the editor's bottom right corner resizes it until the game is closed.
  "panelSize": "720, 435",

  # true = the fleets of an answer are first described in the panel and only spawn when you press Spawn (Discard
  # drops them), so a misread message costs a click, not an unwanted fleet. false = they spawn straight away.
  # Optional, default true.
  "confirmBeforeSpawn": true
}